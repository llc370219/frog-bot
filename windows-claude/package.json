{
  "name": "frog-windows",
  "productName": "frog",
  "version": "0.1.10",
  "description": "frog Windows 原生桌面客户端 —— 多服务器 AI 助理、后台任务与客户端 Bot 互联",
  "author": "frog",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis zip --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "io.github.llc370219.frog",
    "productName": "frog",
    "copyright": "Copyright © 2026 frog",
    "asar": true,
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/tray.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "frog-windows-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "frog",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "frog-windows-setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "llc370219",
        "repo": "frog-bot"
      }
    ]
  }
}
